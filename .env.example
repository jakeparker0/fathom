# Fathom - local configuration template
#
# Copy to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This file is committed and
# must list every key the app reads - if you add a field to
# src/fathom/config.py, add it here in the same commit.
#
# In Sprint 6 (PL-13) these values move to OCI Vault. The keys stay the same.

# --- Runtime -----------------------------------------------------------------
# local | production
ENVIRONMENT=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Up Bank -----------------------------------------------------------------
# REQUIRED. Personal access token, generated at https://api.up.com.au
# Format looks like: up:yeah:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
UP_API_TOKEN=

UP_API_BASE_URL=https://api.up.com.au/api/v1

# --- Database ----------------------------------------------------------------
# These same values are read by docker-compose.yml (S1-03) when it starts the
# local Postgres container, so the app and the database cannot drift apart.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fathom
POSTGRES_USER=fathom
# REQUIRED. Any value locally; a real secret in production.
POSTGRES_PASSWORD=

# SQLAlchemy driver. Revisit once ADR-002 lands: use postgresql+asyncpg if the
# backend framework choice is async.
POSTGRES_DRIVER=postgresql+psycopg